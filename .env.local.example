# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Mock 모드 (외부 API 키 없이 전체 플로우 데모 가능)
# true 로 두면 OTP 콘솔 출력 + 결제 자동성공 + 메모리 저장으로 동작
NEXT_PUBLIC_MOCK_MODE=true

# Supabase (실서비스 시 입력)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (이메일 발송, 실서비스 시 입력) — 네이버웍스 기본값 예시
# Mock 모드(NEXT_PUBLIC_MOCK_MODE=true)에서는 미설정 가능
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=587
SMTP_USER=gt.min@hwaseon.com
SMTP_PASS=

# 토스페이먼츠 (실서비스 시 입력)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 관리자 비밀번호
ADMIN_PASSWORD=your_secure_password_here

# 세무사 전용 페이지(/advisor) 비밀번호
ADVISOR_PASSWORD=advisor1234

# Anthropic (자금조달계획서 AI 자동작성, 실서비스 시 입력)
# Mock 모드(NEXT_PUBLIC_MOCK_MODE=true)에서는 미설정 가능
ANTHROPIC_API_KEY=

# 이메일 발송 API (/api/send-email) 인증 키 — CCR 루틴 등 외부 호출용
# 랜덤 32자 이상 권장. Vercel 환경변수에도 동일하게 추가 필요
EMAIL_API_KEY=

# 만기 알림 크론 (/api/cron/expiry-check) 인증 시크릿
# Authorization: Bearer {CRON_SECRET} 헤더 검증에 사용. 랜덤 32자 이상 권장
# Vercel Cron / 외부 트리거가 동일 값을 헤더에 담아 호출해야 함
CRON_SECRET=

# 관리자/세무사 알림 수신 이메일 (세무상담 신청 알림, 세무사 일괄 발송 수신지)
# 미설정 시 기본값 gt.min@hwaseon.com 사용
ADMIN_NOTIFY_EMAIL=gt.min@hwaseon.com
