# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Mock 모드 (외부 API 키 없이 전체 플로우 데모 가능)
# true 로 두면 OTP 콘솔 출력 + 결제 자동성공 + 메모리 저장으로 동작
NEXT_PUBLIC_MOCK_MODE=true

# Supabase (실서비스 시 입력)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (이메일 발송, 실서비스 시 입력)
RESEND_API_KEY=

# 토스페이먼츠 (실서비스 시 입력)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 관리자 비밀번호
ADMIN_PASSWORD=your_secure_password_here

# Anthropic (자금조달계획서 AI 자동작성, 실서비스 시 입력)
# Mock 모드(NEXT_PUBLIC_MOCK_MODE=true)에서는 미설정 가능
ANTHROPIC_API_KEY=
